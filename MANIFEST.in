# Include the framework source and metadata
include LICENSE
include README.md
include CHANGELOG.md
include pyproject.toml
recursive-include easycord *.py py.typed
recursive-include docs *.md
recursive-include examples *.py
recursive-include context *.md

# Exclude everything that is not part of the published library
exclude .gitignore
exclude AGENTS.md
exclude CLAUDE.md
prune tests
prune scripts
prune release_v*
prune .github
prune .claude
prune .pytest_cache
prune .pytest_cache_codex
prune .tmp_pytest
prune .coderabbit-bin
global-exclude __pycache__
global-exclude *.py[cod]
global-exclude *.pyo
global-exclude .DS_Store
global-exclude Thumbs.db
